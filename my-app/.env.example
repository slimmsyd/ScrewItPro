# =============================================================================
# Screw It Pro - Environment Variables
# Copy to .env.local and fill in real values:
# cp .env.example .env.local
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Screw It Pro

# -----------------------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Stripe
# Dashboard → Developers → API keys
# Webhooks → endpoint signing secret (for /api/webhooks/stripe)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Resend (transactional email)
# Dashboard → API Keys
# Domain must be verified before sending from a custom from-address
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Screw It Pro <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# DeepSeek (AI chat - OpenAI-compatible API)
# https://platform.deepseek.com/api_keys
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Google Cloud
# Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API (as needed)
# -----------------------------------------------------------------------------
# Browser Maps / Places (restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# Optional server-only key for Geocoding / Distance Matrix (restrict by IP)
GOOGLE_MAPS_SERVER_KEY=AIza...
# GA4 measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# Optional OAuth (or configure Google provider in Supabase Auth instead)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
