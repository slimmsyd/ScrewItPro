# =============================================================================
# Screw It Pro - Environment Variables
# Copy to .env.local and fill in real values:
# cp .env.example .env.local
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Screw It Pro

# -----------------------------------------------------------------------------
# Supabase (required for accounts + waitlist)
# Dashboard → Project Settings → API
# Auth → Providers → Email: enable
# Signup uses service role with email_confirm=true (no Supabase confirm email yet)
# Apply migrations under supabase/migrations/ (waitlist + foundation + converted_user)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only - never expose to the browser (used by POST /api/waitlist)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Stripe
# Dashboard → Developers → API keys
# Webhooks → endpoint signing secret (for /api/webhooks/stripe)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Resend (transactional email)
# Dashboard → API Keys
# Domain must be verified before sending from a custom from-address
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Screw It Pro <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# DeepSeek (AI chat - OpenAI-compatible API)
# https://platform.deepseek.com/api_keys
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Google Cloud
# Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API (as needed)
# -----------------------------------------------------------------------------
# Browser Maps / Places (restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# Optional server-only key for Geocoding / Distance Matrix (restrict by IP)
GOOGLE_MAPS_SERVER_KEY=AIza...
# GA4 measurement ID — wired into the site (gated: gtag loads only when set).
# A GA4 property does NOT require the live domain; create it and paste the ID here.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# Optional OAuth (or configure Google provider in Supabase Auth instead)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# CRM people capture (waitlist + inquiries → Users CRM Google Sheet)
# n8n webhook that upserts each person (by email) into the Users CRM sheet.
# OPTIONAL: leave unset and people still persist to Supabase; the n8n mirror is
# simply skipped. Set to the PRODUCTION webhook URL after activating the
# "ScrewIt Pros — Users CRM → Google Sheets" workflow in n8n.
#   e.g. https://oncode.app.n8n.cloud/webhook/screwitpro-crm
# -----------------------------------------------------------------------------
N8N_CRM_WEBHOOK_URL=

# Where internal "new lead" notification emails go (optional).
INQUIRY_NOTIFY_EMAIL=

# -----------------------------------------------------------------------------
# Internal leads dashboard (/admin/leads)
# Interim shared-token gate until M1 role-based auth lands. Open the page with
# ?key=<this value>. Leave unset to keep the view disabled.
# -----------------------------------------------------------------------------
ADMIN_DASHBOARD_TOKEN=
